@echo off
set "CAKE_GAME_ROOT=%~dp0"
powershell.exe -NoProfile -Command "$root=[IO.Path]::GetFullPath($env:CAKE_GAME_ROOT); $listener=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,8765); try {$listener.Start()} catch {Write-Host 'Port 8765 is in use. Close the other game window and try again.'; Read-Host; exit}; Start-Process 'http://127.0.0.1:8765/'; Write-Host 'Cake Road is running. Keep this window open. Ctrl+C stops it.'; try {while($true){$client=$listener.AcceptTcpClient(); $stream=$client.GetStream(); try {$reader=[IO.StreamReader]::new($stream,[Text.Encoding]::ASCII,$false,1024,$true); $line=$reader.ReadLine(); if(!$line){continue}; $parts=$line.Split(' '); do {$h=$reader.ReadLine()} while($h -and $h.Length -gt 0); $relative=[Uri]::UnescapeDataString(($parts[1].Split('?')[0])).TrimStart('/'); if(!$relative){$relative='index.html'}; $path=[IO.Path]::GetFullPath([IO.Path]::Combine($root,$relative)); $ext=[IO.Path]::GetExtension($path).ToLower(); $types=@{'.html'='text/html; charset=utf-8';'.js'='text/javascript';'.css'='text/css';'.png'='image/png';'.mp4'='video/mp4';'.mp3'='audio/mpeg';'.glb'='model/gltf-binary';'.woff2'='font/woff2';'.txt'='text/plain; charset=utf-8'}; if(!$path.StartsWith($root,[StringComparison]::OrdinalIgnoreCase) -or !$types.ContainsKey($ext) -or !(Test-Path -LiteralPath $path -PathType Leaf)){$header='HTTP/1.1 404 Not Found'+[char]13+[char]10+'Content-Length: 0'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10; $bytes=[Text.Encoding]::ASCII.GetBytes($header);$stream.Write($bytes,0,$bytes.Length);continue}; $file=[IO.File]::OpenRead($path); try {$header='HTTP/1.1 200 OK'+[char]13+[char]10+'Content-Type: '+$types[$ext]+[char]13+[char]10+'Content-Length: '+$file.Length+[char]13+[char]10+'Cache-Control: no-cache'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10; $bytes=[Text.Encoding]::ASCII.GetBytes($header);$stream.Write($bytes,0,$bytes.Length); if($parts[0] -ne 'HEAD'){$file.CopyTo($stream)}} finally {$file.Dispose()}} catch {} finally {$stream.Dispose();$client.Dispose()}}} finally {$listener.Stop()}"
